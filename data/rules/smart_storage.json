{
  "_note": "Кубическое хранение (SmartCube, 4 робота на станцию, 2000 кг/м²). К семейству station_robots — нагрузка на пол и верх температуры: куб тяжелее шаттла и ставится на существующее перекрытие. В скоринге throughput.",
  "solution_type": "smart_storage",
  "hard": [
    { "field": "payload_kg", "op": ">=", "ref": "task.max_load_kg" },
    { "field": "temp_min_c", "op": "<=", "ref": "site.temp_min_c" },
    { "field": "temp_max_c", "op": ">=", "ref": "site.temp_max_c" },
    { "field": "floor_load_kg_m2", "op": "<=", "ref": "site.floor_load_kg_m2" }
  ],
  "soft": [
    { "field": "trl", "weight": 0.2, "dir": "max" },
    { "field": "availability", "weight": 0.15, "map": { "operation": 1.0, "piloting": 0.5, "rnd": 0.0 } },
    { "field": "reliability", "weight": 0.2, "map": { "A": 1.0, "B": 0.7, "C": 0.35, "D": 0.1 } },
    { "field": "price_rub", "weight": 0.1, "dir": "min" },
    { "field": "has_case", "weight": 0.15, "dir": "max" },
    { "field": "throughput", "weight": 0.2, "dir": "max" }
  ],
  "sizing": {
    "family": "station_robots",
    "vars": {
      "stations": "ceil(task.flow_per_hour / (robot.throughput * norm.k_util))"
    },
    "formula": "ceil(stations * robot.robots_per_station) + norm.n_reserve"
  }
}
