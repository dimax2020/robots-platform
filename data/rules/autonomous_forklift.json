{
  "_note": "Беспилотный погрузчик (склад). К семейству flow_cycle добавляется высота подъёма: вилы должны доставать до высоты хранения. Без этой проверки погрузчик с низкой мачтой проходит как обычный транспорт.",
  "solution_type": "autonomous_forklift",
  "hard": [
    { "field": "payload_kg", "op": ">=", "ref": "task.max_load_kg" },
    { "field": "min_aisle_width_m", "op": "<=", "ref": "site.aisle_width_m" },
    { "field": "temp_min_c", "op": "<=", "ref": "site.temp_min_c" },
    { "field": "temp_max_c", "op": ">=", "ref": "site.temp_max_c" },
    { "field": "floor_load_kg_m2", "op": "<=", "ref": "site.floor_load_kg_m2" },
    { "field": "lift_height_mm", "op": ">=", "ref": "site.storage_height_m * 1000" }
  ],
  "soft": [
    { "field": "trl", "weight": 0.25, "dir": "max" },
    { "field": "availability", "weight": 0.2, "map": { "operation": 1.0, "piloting": 0.5, "rnd": 0.0 } },
    { "field": "reliability", "weight": 0.2, "map": { "A": 1.0, "B": 0.7, "C": 0.35, "D": 0.1 } },
    { "field": "price_rub", "weight": 0.2, "dir": "min" },
    { "field": "has_case", "weight": 0.15, "dir": "max" }
  ],
  "sizing": {
    "family": "flow_cycle",
    "vars": {
      "t_cycle": "2 * task.route_len_m / robot.speed_loaded_ms + task.t_load_s + task.t_unload_s + norm.t_wait_s",
      "uptime": "robot.work_time_h / (robot.work_time_h + robot.charge_time_h)",
      "q": "3600 / t_cycle * uptime * norm.k_util"
    },
    "formula": "ceil(task.flow_per_hour / q) + norm.n_reserve"
  }
}
