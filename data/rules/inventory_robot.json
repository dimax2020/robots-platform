{
  "_note": "Робот-инвентаризатор (склад, мачта 12–12,5 м). Жёсткие правила семейства count_window уже закрывают проход и высоту стеллажа. Добавлен скоринг по throughput: у инвентаризатора сравнивают ячейки/ч, а не цену корпуса.",
  "solution_type": "inventory_robot",
  "hard": [
    { "field": "min_aisle_width_m", "op": "<=", "ref": "site.aisle_width_m" },
    { "field": "lift_height_mm", "op": ">=", "ref": "site.storage_height_m * 1000" }
  ],
  "soft": [
    { "field": "trl", "weight": 0.2, "dir": "max" },
    { "field": "availability", "weight": 0.15, "map": { "operation": 1.0, "piloting": 0.5, "rnd": 0.0 } },
    { "field": "reliability", "weight": 0.15, "map": { "A": 1.0, "B": 0.7, "C": 0.35, "D": 0.1 } },
    { "field": "price_rub", "weight": 0.1, "dir": "min" },
    { "field": "has_case", "weight": 0.15, "dir": "max" },
    { "field": "throughput", "weight": 0.25, "dir": "max" }
  ],
  "sizing": {
    "family": "count_window",
    "vars": {
      "t_window": "site.shift_hours * site.shifts_per_day",
      "q": "robot.throughput * norm.k_util"
    },
    "formula": "ceil(site.pallet_places * norm.f_frequency / (q * t_window)) + norm.n_reserve"
  }
}
