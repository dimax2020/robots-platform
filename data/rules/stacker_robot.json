{
  "_note": "Стационарный робот-штабелёр (склад). Семейство station_robots не проверяет мачту — без lift_height_mm штабелёр на низкую ячейку проходит на высокий стеллаж.",
  "solution_type": "stacker_robot",
  "hard": [
    { "field": "payload_kg", "op": ">=", "ref": "task.max_load_kg" },
    { "field": "temp_min_c", "op": "<=", "ref": "site.temp_min_c" },
    { "field": "lift_height_mm", "op": ">=", "ref": "site.storage_height_m * 1000" }
  ],
  "soft": [
    { "field": "trl", "weight": 0.25, "dir": "max" },
    { "field": "availability", "weight": 0.2, "map": { "operation": 1.0, "piloting": 0.5, "rnd": 0.0 } },
    { "field": "reliability", "weight": 0.2, "map": { "A": 1.0, "B": 0.7, "C": 0.35, "D": 0.1 } },
    { "field": "price_rub", "weight": 0.2, "dir": "min" },
    { "field": "has_case", "weight": 0.15, "dir": "max" }
  ],
  "sizing": {
    "family": "station_robots",
    "vars": {
      "stations": "ceil(task.flow_per_hour / (robot.throughput * norm.k_util))"
    },
    "formula": "ceil(stations * robot.robots_per_station) + norm.n_reserve"
  }
}
