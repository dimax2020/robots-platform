{
  "_note": "Охранный робот (аэропорт, патрулирование). К семейству perimeter_rounds — ширина прохода: в терминале робот ходит по коридорам, а не только по периметру. В скоринге work_time_h: у «Городового» 72 ч автономности, цена это не отражает.",
  "solution_type": "security_robot",
  "hard": [
    { "field": "temp_min_c", "op": "<=", "ref": "site.temp_min_c" },
    { "field": "temp_max_c", "op": ">=", "ref": "site.temp_max_c" },
    { "field": "min_aisle_width_m", "op": "<=", "ref": "site.aisle_width_m" }
  ],
  "soft": [
    { "field": "trl", "weight": 0.2, "dir": "max" },
    { "field": "availability", "weight": 0.15, "map": { "operation": 1.0, "piloting": 0.5, "rnd": 0.0 } },
    { "field": "reliability", "weight": 0.2, "map": { "A": 1.0, "B": 0.7, "C": 0.35, "D": 0.1 } },
    { "field": "price_rub", "weight": 0.15, "dir": "min" },
    { "field": "has_case", "weight": 0.1, "dir": "max" },
    { "field": "work_time_h", "weight": 0.2, "dir": "max" }
  ],
  "sizing": {
    "family": "perimeter_rounds",
    "vars": {
      "t_round": "task.route_len_m / robot.speed_empty_ms + norm.n_stops * norm.t_stop_s",
      "t_window": "site.shift_hours * site.shifts_per_day * 3600"
    },
    "formula": "ceil(norm.rounds_required * t_round / (t_window * norm.k_util)) + norm.n_reserve"
  }
}
