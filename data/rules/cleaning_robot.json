{
  "_note": "Робот-уборщик (склад, аэропорт, медучреждение; 13 продуктов, 6 с ТТХ). К семейству area_window — верх температуры и нагрузка на пол (поломойки 50–400 кг на старых перекрытиях больницы). Ширина прохода уже в шаблоне — это и есть коридор медучреждения. Шума в attributes.json нет, поэтому в скоринге вместо цены стоит throughput (м²/ч).",
  "solution_type": "cleaning_robot",
  "hard": [
    { "field": "min_aisle_width_m", "op": "<=", "ref": "site.aisle_width_m" },
    { "field": "temp_min_c", "op": "<=", "ref": "site.temp_min_c" },
    { "field": "temp_max_c", "op": ">=", "ref": "site.temp_max_c" },
    { "field": "floor_load_kg_m2", "op": "<=", "ref": "site.floor_load_kg_m2" }
  ],
  "soft": [
    { "field": "trl", "weight": 0.2, "dir": "max" },
    { "field": "availability", "weight": 0.15, "map": { "operation": 1.0, "piloting": 0.5, "rnd": 0.0 } },
    { "field": "reliability", "weight": 0.15, "map": { "A": 1.0, "B": 0.7, "C": 0.35, "D": 0.1 } },
    { "field": "price_rub", "weight": 0.1, "dir": "min" },
    { "field": "has_case", "weight": 0.15, "dir": "max" },
    { "field": "throughput", "weight": 0.25, "dir": "max" }
  ],
  "sizing": {
    "family": "area_window",
    "vars": {
      "t_window": "site.shift_hours * site.shifts_per_day",
      "q": "robot.throughput * norm.k_util"
    },
    "formula": "ceil(site.clean_area_m2 * norm.f_passes / (q * t_window)) + norm.n_reserve"
  }
}
